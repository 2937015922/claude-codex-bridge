{
  "name": "claude-codex-bridge",
  "version": "0.5.0-native.1",
  "private": true,
  "description": "Personal native Codex model gateway using the official Claude Code CLI",
  "keywords": [
    "ai",
    "bridge",
    "claude",
    "codex",
    "mcp"
  ],
  "homepage": "https://github.com/2937015922/claude-codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/2937015922/claude-codex-bridge/issues"
  },
  "license": "MIT",
  "author": "Dunqing <dengqing0821@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2937015922/claude-codex-bridge.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Dunqing"
  },
  "bin": {
    "ccb-claude": "./dist/claude-server.mjs",
    "ccb-codex": "./dist/codex-server.mjs",
    "ccb-personal": "./dist/personal-server.mjs",
    "ccb-personal-control": "./dist/personal-control.mjs",
    "ccb-native-gateway": "./dist/native-gateway.mjs",
    "claude-codex-bridge": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "legacy-skills",
    "hooks",
    ".codex-plugin",
    ".mcp.json",
    "mcp.json",
    "plugin.json",
    "PERSONAL.md",
    "scripts"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev:codex-server": "tsx src/codex-server.ts",
    "dev:claude-server": "tsx src/claude-server.ts",
    "test": "vitest run",
    "pretest": "npm run build",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:personal": "node scripts/validate-personal.mjs",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check src/ test/",
    "publint": "publint",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "prepare": "husky"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "citty": "^0.2.0",
    "consola": "^3.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "bumpp": "^10.4.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "publint": "^0.3.17",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.2"
}
